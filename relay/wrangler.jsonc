// The Portage relay: one Worker, one Durable Object per room.
// Pinned to wrangler 4.133.0 (package.json). Local: `npm run dev` (port 8791). Deploy steps: README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portage-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // No address of its own: it answers only on the route deploy/deploy-relay.sh gives it.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The Free plan only runs SQLite-backed Durable Objects. The relay keeps one thing there: a room's idle count,
  // so it outlives the room's sleep. Nothing of the game.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The dial limit: one address may dial a room 30 times a minute (src/dial.ts says why 30, and a test holds
  // the two files together). Cloudflare's rate limiting binding keeps the count, per Cloudflare location, and
  // the Worker asks it before any room is woken. A window is 10 or 60 seconds, nothing else.
  // namespace_id only names the counters. It must be a whole number no other Worker on the account uses
  // (the music site has 1001 and 1002). Changing it starts the counts again.
  // NOTES is the same kind of count for feedback: one address may send 5 notes a minute (src/feedback.ts).
  "ratelimits": [{ "name": "DIALS", "namespace_id": "2201", "simple": { "limit": 30, "period": 60 } },
    { "name": "NOTES", "namespace_id": "2202", "simple": { "limit": 5, "period": 60 } }],
  // Feedback (src/feedback.ts): play testers' notes, one table in a D1 database. On this computer the database
  // is a file under .wrangler/ and the id below is only a name for it. deploy/deploy-relay.sh puts the real
  // id in its place, or takes these lines out when Luc's account has no database called portage-feedback,
  // or when its FEEDBACK switch is off.
  // feedback-store:begin
  "d1_databases": [{ "binding": "NOTES_DB", "database_name": "portage-feedback", "database_id": "local-only-portage-feedback" }],
  // feedback-store:end
  "vars": {
    // Where a connection may come from. `*` stands for any port.
    "ALLOWED_ORIGINS": "https://sigouin.net,http://localhost:*,http://127.0.0.1:*",
    // A room is looked at this often. Three looks in a row with no message through it and it is closed (about half an hour).
    "IDLE_SWEEP_SECONDS": "600",
    // Which build answers at /health. deploy/deploy-relay.sh gives the commit and the upload time instead.
    "BUILD": "local",
    // `off` refuses every note and keeps what is stored. deploy/deploy-relay.sh has the switch (FEEDBACK).
    "FEEDBACK": "on"
  },
  // Nothing is logged, and nothing is kept by Cloudflare's log store either.
  "observability": { "enabled": false }

  // Not in this file, on purpose: the route (sigouin.net/portage/relay/*), the live list of allowed pages
  // (https://sigouin.net alone) and the live build's name. deploy/deploy-relay.sh gives all three to wrangler,
  // so this file stays the one for this computer and its tests.
}
